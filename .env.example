# Copy to .env.local for local configuration. Never commit real secrets.

# Standalone server (npm start). Vite dev uses its own port.
PORT=4173

# Store location for accounts, sessions, photos and uploads.
# Use a throwaway directory when running tests.
# KS_DATA_DIR=server/data

# Required when NODE_ENV=production for the standalone server. Generate long
# random values (at least 32 characters); startup refuses weak/missing secrets.
OTP_PEPPER=
SESSION_SECRET=

# Set to 1 only when a trusted reverse proxy overwrites X-Forwarded-For.
# Leave blank for direct access so clients cannot spoof their IP address.
TRUST_PROXY=

# Twilio Verify for real SMS OTP. Without these, development OTPs are shown.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Optional server-side GroqCloud. Leave blank to keep the assistant fully local.
# The key is read only by server code and is never sent to the browser.
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
